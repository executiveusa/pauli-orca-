{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pauli.local/schemas/factory-job.schema.json",
  "title": "Pauli Factory Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "mode",
    "repository",
    "outcome",
    "constraints",
    "proof",
    "budget"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mode": {
      "type": "string",
      "enum": ["greenfield", "brownfield"]
    },
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "description": "Logical allowlisted repository identifier, not an arbitrary shell argument."
    },
    "base_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "default": "main"
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 50
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "trusted_check",
              "independent_review",
              "artifact",
              "manual_approval"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_runtime_minutes", "max_workers", "max_retries"],
      "properties": {
        "max_runtime_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "requested_worker": {
      "type": "string",
      "maxLength": 128,
      "description": "Optional preference. The supervisor may reject or replace it based on policy and runtime capability."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  }
}
